---
// Amazon Associates program retired 2026-08. This component now refuses to
// render any Amazon/amzn.to link. Pass an explicit non-Amazon `url` (e.g. an
// owned-product funnel link) to render a CTA; otherwise it renders nothing.
export interface Props {
  asin?: string;
  url?: string;
  label?: string;
}
const { url, label = 'Learn more' } = Astro.props;
const isAmazon = (u?: string) => !!u && /amazon\.[a-z.]{2,8}|amzn\.to/i.test(u);
const href = (url && !isAmazon(url)) ? url : undefined;
---
{href && (
  <p class="my-6 text-center">
    <a
      href={href}
      rel="sponsored noopener"
      target="_blank"
      class="btn-primary no-underline"
    >
      {label} -&gt;
    </a>
  </p>
)}
